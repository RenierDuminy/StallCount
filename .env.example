# StallCount environment variables
#
# Copy to `.env` for local development. `.env` is gitignored.
# Only variables prefixed VITE_ reach the browser bundle; everything else is
# server-side and must never be exposed to the client.
#
# Where each group is configured in production:
#   [browser]   Vercel > Settings > Environment Variables
#   [vercel-api] Vercel > Settings > Environment Variables (API routes only)
#   [edge-fn]   Supabase > Edge Functions > Secrets (NOT Vercel)

# ---------------------------------------------------------------------------
# [browser] Read by the app at build time. Required.
# ---------------------------------------------------------------------------
# Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<supabase-anon-key>

# Web Push public key. Generate a pair with: npx web-push generate-vapid-keys
# Must be the SAME public key as VAPID_PUBLIC_KEY on the Edge Function below,
# otherwise push services reject every notification.
VITE_VAPID_PUBLIC_KEY=<vapid-public-key>

# Optional. Where Supabase Auth redirects after login (defaults to the site root).
# VITE_SUPABASE_REDIRECT_URL=https://stallcount.app/

# Optional. Canonical site URL for the generated sitemap (falls back to Vercel's URL).
# VITE_SITE_URL=https://stallcount.app

# ---------------------------------------------------------------------------
# [vercel-api] Read by api/stb-rl-26-roster-sync.js (daily roster import).
# ---------------------------------------------------------------------------
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# CRON_SECRET=<random-string>            # Vercel sends this as a bearer token
# STB_RL_26_SIGNUP_CSV_URL=<csv-url>     # optional
# STB_RL_26_SIGNUP_DOB_MODE=<mode>       # optional

# ---------------------------------------------------------------------------
# [edge-fn] Read by supabase/functions/notification-dispatcher.
# Set these as Edge Function secrets; they are listed here only so the local
# fallback (`npm run dispatch:notifications`) can run with the same values.
# ---------------------------------------------------------------------------
# VAPID_PUBLIC_KEY=<vapid-public-key>    # same value as VITE_VAPID_PUBLIC_KEY
# VAPID_PRIVATE_KEY=<vapid-private-key>  # server-side only
# VAPID_SUBJECT=mailto:ops@stallcount.app
# NOTIFICATION_DISPATCH_SECRET=<random-string>
#   Shared password the database sends as the `x-dispatch-secret` header.
#   Store the same value in Vault as `notification_dispatch_secret`
#   (see supabase/migrations/*notification_dispatch.sql).
# Tuning, all optional:
# NOTIFICATION_BATCH_SIZE=50
# NOTIFICATION_MAX_ATTEMPTS=5
# NOTIFICATION_STALE_AFTER_MINUTES=60
# NOTIFICATION_PUSH_TTL_SECONDS=600
