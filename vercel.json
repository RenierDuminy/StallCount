{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "redirects": [
    {
      "source": "/sitemap",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    { "source": "/event/:slug", "destination": "/events/:slug", "permanent": true },
    { "source": "/tournament-director", "destination": "/admin/tournament-director", "permanent": true },
    { "source": "/match-corrections", "destination": "/admin/match-corrections", "permanent": true },
    { "source": "/sys-admin", "destination": "/admin/system", "permanent": true },
    { "source": "/sys-admin/:path*", "destination": "/admin/system/:path*", "permanent": true },
    { "source": "/score-keeper", "destination": "/scorekeeper", "permanent": true }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
